<?php
/**
 * Copy this file to "config.local.php" (same folder) and fill in your own
 * values below. config.local.php is git-ignored, so your real address and
 * App Password never get committed or pushed to GitHub.
 *
 * How to get a Gmail App Password (takes ~2 minutes):
 *   1. Turn on 2-Step Verification on your Google account, if it isn't
 *      already: https://myaccount.google.com/signinoptions/two-step-verification
 *   2. Go to https://myaccount.google.com/apppasswords
 *   3. Under "App name", type something like "CineVault" and click Create
 *   4. Google shows you a 16-character password (e.g. "abcd efgh ijkl mnop")
 *      — copy it (spaces don't matter) and paste it below as smtp_password
 *   5. This is NOT your normal Gmail password — it only works for this one
 *      app, and you can revoke it any time from the same App Passwords page
 *
 * Deploying somewhere that blocks outbound SMTP (e.g. Render's free tier)?
 * Gmail SMTP will hang and fail there no matter how correct these values
 * are — see the "Resend" option below instead, which sends over plain
 * HTTPS. You can leave the two lines commented out if you're only using
 * Gmail SMTP locally.
 */

return [
    'from_email'    => 'youraddress@gmail.com',
    'admin_emails'  => ['youraddress@gmail.com'],
    'smtp_username' => 'youraddress@gmail.com',
    'smtp_password' => 'your16charapppassword',

    // Uncomment to send via the Resend HTTP API instead of Gmail SMTP
    // (needed on hosts that block outbound SMTP ports, e.g. Render free
    // tier). Get a key at https://resend.com/api-keys.
    // 'mail_transport' => 'resend',
    // 'resend_api_key' => 're_your_api_key',
];
